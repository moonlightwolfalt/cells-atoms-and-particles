# Layout markers — generated by Island Forge for "Competitive Civilization" (Reload).
# Place this device at the CENTRE of your island. On game start it spawns one marker prop
# at every location in the layout. Coordinates are centimetres relative to the device:
# +X = north (map up), +Y = east (map right).

using { /Fortnite.com/Devices }
using { /Verse.org/Simulation }
using { /UnrealEngine.com/Temporary/SpatialMath }

competitive_civilization_island_forge_marker := struct:
    Label : string
    Category : string
    X : float
    Y : float
    Z : float

competitive_civilization_layout_device := class(creative_device):

    @editable
    POIMarker : creative_prop_asset = DefaultCreativePropAsset

    @editable
    FeatureMarker : creative_prop_asset = DefaultCreativePropAsset

    @editable
    RouteMarker : creative_prop_asset = DefaultCreativePropAsset

    # Added to every marker's height (use it if your landscape sits above Z = 0).
    @editable
    HeightOffset : float = 0.0

    @editable
    SpawnOnBegin : logic = true

    var SpawnedProps : []creative_prop = array{}

    Markers : []competitive_civilization_island_forge_marker = array{
        competitive_civilization_island_forge_marker{Label := "FNCS Headquarters", Category := "poi", X := 0.0, Y := 0.0, Z := 1800.0},
        competitive_civilization_island_forge_marker{Label := "Victory Cup Practice Room", Category := "poi", X := 18330.0, Y := -18330.0, Z := 1200.0},
        competitive_civilization_island_forge_marker{Label := "Performance Eval Palace", Category := "poi", X := 18330.0, Y := 18330.0, Z := 4500.0},
        competitive_civilization_island_forge_marker{Label := "Ranked Cup Strategy Camp", Category := "poi", X := -18330.0, Y := 18330.0, Z := 2100.0},
        competitive_civilization_island_forge_marker{Label := "Cash Cup Ruins", Category := "poi", X := -18330.0, Y := -18330.0, Z := 1500.0},
        competitive_civilization_island_forge_marker{Label := "Icon Cup Gallery", Category := "poi", X := 46800.0, Y := 0.0, Z := 3300.0},
        competitive_civilization_island_forge_marker{Label := "Hype Cup Heights", Category := "poi", X := 33150.0, Y := 33150.0, Z := 4200.0},
        competitive_civilization_island_forge_marker{Label := "Console Cash Cup Docks", Category := "poi", X := 0.0, Y := 46800.0, Z := 600.0},
        competitive_civilization_island_forge_marker{Label := "Last Chance Qualifier Lodge", Category := "poi", X := -33150.0, Y := 33150.0, Z := 1800.0},
        competitive_civilization_island_forge_marker{Label := "World Cup Stadium", Category := "poi", X := -46800.0, Y := 0.0, Z := 1200.0},
        competitive_civilization_island_forge_marker{Label := "Early Access Cup Lab", Category := "poi", X := -33150.0, Y := -33150.0, Z := 1200.0},
        competitive_civilization_island_forge_marker{Label := "Skin Cup Boutique", Category := "poi", X := 0.0, Y := -46800.0, Z := 900.0},
        competitive_civilization_island_forge_marker{Label := "Global Championship Grounds", Category := "poi", X := 33150.0, Y := -33150.0, Z := 2400.0},
        competitive_civilization_island_forge_marker{Label := "Vault", Category := "vault", X := 1040.0, Y := 780.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Vending Machine", Category := "vending_machine", X := 8060.0, Y := 7800.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Vending Machine", Category := "vending_machine", X := -8060.0, Y := -8970.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Vending Machine", Category := "vending_machine", X := -16640.0, Y := 40950.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Vending Machine", Category := "vending_machine", X := 17160.0, Y := -38870.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Launch Pad", Category := "launch_pad", X := 40820.0, Y := 17550.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Launch Pad", Category := "launch_pad", X := -39000.0, Y := -16250.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Launch Pad", Category := "launch_pad", X := -8710.0, Y := -33930.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Supply Drop", Category := "supply_drop", X := 10270.0, Y := -9750.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Supply Drop", Category := "supply_drop", X := -9360.0, Y := 10660.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Supply Drop", Category := "supply_drop", X := -38610.0, Y := 16120.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Campfire", Category := "campfire", X := 16510.0, Y := 40300.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Campfire", Category := "campfire", X := -15080.0, Y := -38740.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Campfire", Category := "campfire", X := 41080.0, Y := -15730.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Zipline", Category := "zipline", X := 24700.0, Y := 24570.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Zipline", Category := "zipline", X := -26390.0, Y := -24440.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Rift", Category := "rift", X := 34580.0, Y := -8060.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Bus Start", Category := "route", X := 39000.0, Y := -57200.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Bus End", Category := "route", X := -41600.0, Y := 57200.0, Z := 0.0},
        competitive_civilization_island_forge_marker{Label := "Final Circle", Category := "route", X := -6500.0, Y := -3900.0, Z := 0.0}
    }

    OnBegin<override>()<suspends> : void =
        if (SpawnOnBegin?):
            SpawnLayout()

    PickAsset(Category : string) : creative_prop_asset =
        if (Category = "poi"):
            POIMarker
        else if (Category = "route"):
            RouteMarker
        else:
            FeatureMarker

    SpawnLayout() : void =
        Origin := GetTransform().Translation
        for (Marker : Markers):
            Position := vector3{X := Origin.X + Marker.X, Y := Origin.Y + Marker.Y, Z := Origin.Z + Marker.Z + HeightOffset}
            SpawnResult := SpawnProp(PickAsset(Marker.Category), Position, IdentityRotation())
            if (Prop := SpawnResult(0)?):
                set SpawnedProps += array{Prop}
        Print("Island Forge: spawned {SpawnedProps.Length} layout markers")

    ClearLayout() : void =
        for (Prop : SpawnedProps):
            Prop.Dispose()
        set SpawnedProps = array{}
