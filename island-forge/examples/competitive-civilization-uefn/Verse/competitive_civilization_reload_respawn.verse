# Reload respawns — generated by Island Forge for "Competitive Civilization" (Reload).
# Players respawn as long as a teammate is still alive. When the whole squad is down, or after
# CutoffSeconds, anyone who spawns again is sent to the spectator box instead.

using { /Fortnite.com/Devices }
using { /Fortnite.com/Characters }
using { /Fortnite.com/Game }
using { /Fortnite.com/Teams }
using { /Verse.org/Simulation }

competitive_civilization_reload_respawn_device := class(creative_device):

    @editable
    Spawners : []player_spawner_device = array{}

    @editable
    SpectatorTeleporter : teleporter_device = teleporter_device{}

    @editable
    RespawnsOffMessage : hud_message_device = hud_message_device{}

    @editable
    CutoffSeconds : float = 440.0

    var RespawnsOpen : logic = true
    var Alive : [agent]logic = map{}
    var Out : [agent]logic = map{}

    var WatchedPlayers : [player]logic = map{}

    # Subscribes to every player's elimination event, including players who join late.
    WatchEliminations()<suspends> : void =
        loop:
            for (Player : GetPlayspace().GetPlayers(), not WatchedPlayers[Player]?, Character := Player.GetFortCharacter[]):
                Character.EliminatedEvent().Subscribe(OnEliminated)
                if (set WatchedPlayers[Player] = true) {}
            Sleep(1.0)

    OnBegin<override>()<suspends> : void =
        for (Spawner : Spawners):
            Spawner.SpawnedEvent.Subscribe(OnSpawned)
        spawn{ WatchEliminations() }
        Sleep(CutoffSeconds)
        set RespawnsOpen = false
        RespawnsOffMessage.Show()

    OnSpawned(Agent : agent) : void =
        if (Out[Agent]?):
            SpectatorTeleporter.Teleport(Agent)
        else:
            if (set Alive[Agent] = true) {}

    OnEliminated(Result : elimination_result) : void =
        if (Victim := Result.EliminatedCharacter.GetAgent[]):
            if (set Alive[Victim] = false) {}
            if (not RespawnsOpen?):
                if (set Out[Victim] = true) {}
            else if (not HasLivingTeammate[Victim]):
                KnockOutTeam(Victim)

    HasLivingTeammate(Agent : agent)<decides><transacts> : void =
        Teams := GetPlayspace().GetTeamCollection()
        Team := Teams.GetTeam[Agent]
        Mates := Teams.GetAgents[Team]
        Living := for (Mate : Mates, Mate <> Agent, Alive[Mate]?) { Mate }
        Living.Length > 0

    KnockOutTeam(Agent : agent) : void =
        if (set Out[Agent] = true) {}
        Teams := GetPlayspace().GetTeamCollection()
        if (Team := Teams.GetTeam[Agent], Mates := Teams.GetAgents[Team]):
            for (Mate : Mates):
                if (set Out[Mate] = true) {}
