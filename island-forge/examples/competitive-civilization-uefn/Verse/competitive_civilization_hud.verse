# Match HUD — generated by Island Forge for "Competitive Civilization" (Reload).
# Shows the island name, a countdown and an objective hint at the top of the screen.

using { /Fortnite.com/Devices }
using { /Fortnite.com/UI }
using { /UnrealEngine.com/Temporary/UI }
using { /UnrealEngine.com/Temporary/SpatialMath }
using { /Verse.org/Simulation }
using { /Verse.org/Colors }

competitive_civilization_match_hud_msg<localizes>(Text : string) : message = "{Text}"

competitive_civilization_hud_device := class(creative_device):

    @editable
    Title : string = "COMPETITIVE CIVILIZATION"

    @editable
    Hint : string = "Small island, squads, respawn while a teammate is still alive — until the late storm."

    @editable
    RoundSeconds : int = 900

    var TimerTexts : [player]text_block = map{}

    OnBegin<override>()<suspends> : void =
        for (Player : GetPlayspace().GetPlayers()):
            AddHud(Player)
        GetPlayspace().PlayerAddedEvent().Subscribe(AddHud)
        var Remaining : int = RoundSeconds
        loop:
            if (Remaining < 0):
                break
            if (Minutes := Quotient[Remaining, 60], Seconds := Mod[Remaining, 60]):
                Padded := if (Seconds < 10) then "0{Seconds}" else "{Seconds}"
                SetAll("{Title}   {Minutes}:{Padded}")
            Sleep(1.0)
            set Remaining -= 1

    AddHud(Player : player) : void =
        if (PlayerUI := GetPlayerUI[Player]):
            TimerText := text_block{DefaultText := competitive_civilization_match_hud_msg(Title), DefaultTextColor := NamedColors.White}
            HintText := text_block{DefaultText := competitive_civilization_match_hud_msg(Hint), DefaultTextColor := NamedColors.Gold}
            Canvas := canvas:
                Slots := array:
                    canvas_slot:
                        Anchors := anchors{Minimum := vector2{X := 0.5, Y := 0.0}, Maximum := vector2{X := 0.5, Y := 0.0}}
                        Offsets := margin{Top := 36.0}
                        Alignment := vector2{X := 0.5, Y := 0.0}
                        SizeToContent := true
                        Widget := TimerText
                    canvas_slot:
                        Anchors := anchors{Minimum := vector2{X := 0.5, Y := 0.0}, Maximum := vector2{X := 0.5, Y := 0.0}}
                        Offsets := margin{Top := 72.0}
                        Alignment := vector2{X := 0.5, Y := 0.0}
                        SizeToContent := true
                        Widget := HintText
            PlayerUI.AddWidget(Canvas)
            if (set TimerTexts[Player] = TimerText) {}

    SetAll(Text : string) : void =
        for (Player -> Block : TimerTexts):
            Block.SetText(competitive_civilization_match_hud_msg(Text))
