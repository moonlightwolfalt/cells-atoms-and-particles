# Elimination scoring — generated by Island Forge for "Competitive Civilization" (Reload).
# Awards points to the eliminator and ends the game at ScoreToWin.

using { /Fortnite.com/Devices }
using { /Fortnite.com/Characters }
using { /Fortnite.com/Game }
using { /Verse.org/Simulation }

competitive_civilization_elimination_scoring_device := class(creative_device):

    @editable
    ScoreManager : score_manager_device = score_manager_device{}

    @editable
    EndGame : end_game_device = end_game_device{}

    @editable
    PointsPerElimination : int = 1

    # 0 = no limit.
    @editable
    ScoreToWin : int = 0

    var Eliminations : [agent]int = map{}

    var WatchedPlayers : [player]logic = map{}

    # Subscribes to every player's elimination event, including players who join late.
    WatchEliminations()<suspends> : void =
        loop:
            for (Player : GetPlayspace().GetPlayers(), not WatchedPlayers[Player]?, Character := Player.GetFortCharacter[]):
                Character.EliminatedEvent().Subscribe(OnEliminated)
                if (set WatchedPlayers[Player] = true) {}
            Sleep(1.0)

    OnBegin<override>()<suspends> : void =
        ScoreManager.SetScoreAward(PointsPerElimination)
        WatchEliminations()

    OnEliminated(Result : elimination_result) : void =
        if:
            Killer := Result.EliminatingCharacter?
            KillerAgent := Killer.GetAgent[]
            Victim := Result.EliminatedCharacter.GetAgent[]
            KillerAgent <> Victim
        then:
            ScoreManager.Activate(KillerAgent)
            Count := (if (Old := Eliminations[KillerAgent]) then Old else 0) + 1
            if (set Eliminations[KillerAgent] = Count) {}
            if (ScoreToWin > 0, Count >= ScoreToWin):
                EndGame.Activate(KillerAgent)
